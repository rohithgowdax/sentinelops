# SentinelOps environment configuration
# Copy this file to .env and adjust values for your environment.
# All variables are prefixed with SENTINELOPS_

# Service identity
SENTINELOPS_SERVICE_NAME=sentinelops
SENTINELOPS_ENVIRONMENT=development
SENTINELOPS_LOG_LEVEL=INFO

# Redis EventBus
SENTINELOPS_REDIS_URL=redis://localhost:6379/0
SENTINELOPS_REDIS_TELEMETRY_STREAM=sentinel:telemetry
SENTINELOPS_REDIS_INCIDENTS_STREAM=sentinel:incidents
SENTINELOPS_REDIS_CONSUMER_GROUP=sentinelops-workers

# PostgreSQL OperationalStore
SENTINELOPS_POSTGRES_DSN=postgresql+asyncpg://sentinelops:sentinelops@localhost:5432/sentinelops
SENTINELOPS_POSTGRES_POOL_SIZE=5

# Detection engine
SENTINELOPS_DETECTION_RULES_PATH=config/detection_rules.yaml
SENTINELOPS_DETECTION_INTERVAL_SECONDS=10.0

# Ingestion worker
SENTINELOPS_WORKER_BATCH_SIZE=20
SENTINELOPS_WORKER_BLOCK_MS=2000

# API
SENTINELOPS_API_HOST=0.0.0.0
SENTINELOPS_API_PORT=8000
